{
  "name": "sokora",
  "description": "Welcome to Sokora, a multipurpose Discord bot that lets you manage your servers easily.",
  "contributors": [
    "The Sokora team",
    "The GitHub contributors"
  ],
  "version": "0.4",
  "main": "./src/index.ts",
  "type": "module",
  "scripts": {
    "setup": "bun i && bun run cli/setup.ts",
    "dev": "bun --watch ./src/bot.ts",
    "start": "bun ./src/index.ts",
    "start:docker": "sudo docker compose down && sudo docker compose up --build --watch --remove-orphans",
    "ql": "bun fmt; bun check; eslint . --fix --no-warn-ignored"
  },
  "dependencies": {
    "@subetedesu/honlvlimport": "npm:@jsr/subetedesu__honlvlimport@^2.0.0",
    "@top-gg/sdk": "^4.0.0",
    "chart.js": "^4.6.1",
    "chartjs-node-canvas": "^5.0.0",
    "colorthief": "^3.5.0",
    "discord.js": "^14.27.0",
    "enhanced-ms": "^5.0.0",
    "git-diff": "^2.0.7",
    "mathjs": "^15.2.0",
    "p-limit": "^7.3.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/git-diff": "^2.0.7",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "bun-types": "^1.4.4",
    "eslint": "^10.13.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
